# Script/resource CSP (including script hashes) is generated in HTML by astro.config.mjs.
# Selainturvaotsakkeet kaikille Cloudflare Workersin staattisille reiteille.
# HSTS määritetään Cloudflaren Edge Certificates -asetuksissa.
/*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# The filenames are stable, so revalidate after one day rather than caching immutably.
/dBcheck-hero-mobile.mp4
  Cache-Control: public, max-age=86400

/dBcheck-hero-desktop.mp4
  Cache-Control: public, max-age=86400
