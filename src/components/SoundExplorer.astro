---
import type { CommonSound } from '../data/sounds';
import type { Locale } from '../i18n/config';
import { DISPLAY_TICKS, EXPOSURE_LIMIT_DB, scalePercent } from '../lib/display-scale';

interface Props {
  sounds: CommonSound[];
  id?: string;
  compact?: boolean;
  locale?: Locale;
}

const { sounds, id = 'sound-explorer', compact = false, locale = 'en' } = Astro.props;
const initial = sounds[0];
const isGerman = locale === 'de';

/** Äänen tyypillinen vaihteluväli näyttöasteikon osuutena; sama palkki näyttää sen asteikolla. */
const bandFor = (sound: CommonSound) => {
  const start = scalePercent(sound.typicalMinDb);
  return { start, span: scalePercent(sound.typicalMaxDb) - start };
};
const initialBand = bandFor(initial);
const exposureLimitAt = scalePercent(EXPOSURE_LIMIT_DB);
const sourcedSounds = sounds.flatMap((sound) => sound.rangeReference ? [{ sound, reference: sound.rangeReference }] : []);

/** Asteikon numerot sijoitetaan todellisille kohdilleen, ei tasavälein. */
const scaleTicks = DISPLAY_TICKS.map((db, index) => ({
  at: scalePercent(db),
  label: index === DISPLAY_TICKS.length - 1 ? `${db} dB` : String(db),
}));
---

<div id={id} class:list={['sound-explorer', { compact }]} data-sound-explorer>
  <div class="sound-scale" aria-label={isGerman ? 'Alltagsgeräusche auf einer Skala von 0 bis 130 Dezibel' : 'Common sound examples on a 0 to 130 decibel display scale'}>
    <div class="sound-markers" style={`--band-start:${initialBand.start};--band-span:${initialBand.span};--exposure-limit-at:${exposureLimitAt}%`}>
      <div class="scale-track" aria-hidden="true">
        {scaleTicks.map((tick) => <span style={`--at:${tick.at}%`}>{tick.label}</span>)}
      </div>
      <span class:list={['range-band', initial.riskLevel]} data-range-band aria-hidden="true"></span>
      {sounds.map((sound, index) => (
        <button
          type="button"
          class:list={['sound-marker', sound.riskLevel, { active: index === 0 }]}
          style={`--position:${scalePercent((sound.typicalMinDb + sound.typicalMaxDb) / 2)}%;--marker-index:${index}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls={`${id}-detail`}
          data-name={sound.name}
          data-range={`${sound.typicalMinDb}–${sound.typicalMaxDb} dB`}
          data-description={sound.shortDescription}
          data-note={sound.exposureNote}
          data-route={sound.articleRoute ?? ''}
          data-lane={sound.markerLane}
          data-risk={sound.riskLevel}
          data-band-start={bandFor(sound).start}
          data-band-span={bandFor(sound).span}
        >
          <span class="marker-dot" aria-hidden="true"></span>
          <span>{sound.name}</span>
        </button>
      ))}
    </div>
  </div>

  <article class="sound-detail" id={`${id}-detail`} aria-live="polite">
    <div>
      <span class="detail-category">{isGerman ? 'Typisches Beispiel' : 'Typical example'}</span>
      <h3 data-sound-name>{initial.name}</h3>
      <p data-sound-description>{initial.shortDescription}</p>
      <p class="exposure-note" data-sound-note>{initial.exposureNote}</p>
    </div>
    <div class="detail-reading">
      <strong data-sound-range>{initial.typicalMinDb}–{initial.typicalMaxDb} dB</strong>
      <a data-sound-route href={initial.articleRoute ?? (isGerman ? '/de/alltagsgeraeusche/' : '/sounds/')} hidden={!initial.articleRoute}>{isGerman ? 'Ratgeber lesen' : 'Read sound guide'} <span aria-hidden="true">→</span></a>
    </div>
  </article>

  <div class="mobile-sound-view">
    <div class="mobile-scale-key" aria-hidden="true"><span>0</span><span>130 dB</span></div>
    <ul class="mobile-sound-list" aria-label={isGerman ? 'Alltagsgeräusche nach typischem Dezibelbereich' : 'Common sound examples by typical decibel range'}>
      {sounds.map((sound, index) => (
        <li style={`--sound-index:${index}`}>
          <details name={`${id}-mobile-sounds`}>
            <summary>
              <span class:list={['mobile-risk-dot', sound.riskLevel]} aria-hidden="true"></span>
              <span class="mobile-sound-name">{sound.name}</span>
              <strong>{sound.typicalMinDb}–{sound.typicalMaxDb} dB</strong>
              <span class="mobile-disclosure" aria-hidden="true"></span>
              <span class="mobile-range-track" aria-hidden="true">
                <span
                  class:list={['mobile-range-fill', sound.riskLevel]}
                  style={`--range-start:${scalePercent(sound.typicalMinDb)}%;--range-end:${scalePercent(sound.typicalMaxDb)}%`}
                ></span>
              </span>
            </summary>
            <div class="mobile-sound-detail">
              <p>{sound.shortDescription}</p>
              <p class="mobile-exposure-note">{sound.exposureNote}</p>
              {sound.articleRoute && <a href={sound.articleRoute}>{isGerman ? 'Ratgeber lesen' : 'Read sound guide'} <span aria-hidden="true">→</span></a>}
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>

  <p class="sound-disclaimer">{isGerman ? 'Typische Bereiche variieren mit Abstand, Umgebung, Quelle und Messmethode.' : 'Typical ranges vary with distance, environment, source and measurement method.'}</p>

  {sourcedSounds.length > 0 && (
    <details class="sound-sources">
      <summary>{isGerman ? 'Quellen zu den Referenzbereichen' : 'Sources for reference ranges'}</summary>
      <div class="sound-sources-content">
        <p>{isGerman ? 'Diese Näherungsbereiche hängen von Abstand, Messgröße und Messbedingungen ab.' : 'These approximate ranges depend on distance, metric and measurement conditions.'}</p>
        <ul>
          {sourcedSounds.map(({ sound, reference }) => (
            <li>
              <p><strong>{sound.name}: {sound.typicalMinDb}–{sound.typicalMaxDb} {reference.source.metric}.</strong> {reference.context}</p>
              <p class="source-citation">
                <span>{isGerman ? 'Quelle:' : 'Source:'}</span>{' '}
                <a href={reference.source.url}><cite>{reference.source.title}</cite></a>
                <span> — {reference.source.credit}, {reference.source.publisher}, {reference.source.publicationDate}{reference.source.revisionDate ? `; ${isGerman ? 'überarbeitet' : 'revised'} ${reference.source.revisionDate}` : ''}.</span>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </details>
  )}
</div>

<script>
  import { scrambleReading } from '../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-sound-explorer]').forEach((explorer) => {
    const markers = Array.from(explorer.querySelectorAll<HTMLButtonElement>('.sound-marker'));
    const name = explorer.querySelector<HTMLElement>('[data-sound-name]');
    const range = explorer.querySelector<HTMLElement>('[data-sound-range]');
    const description = explorer.querySelector<HTMLElement>('[data-sound-description]');
    const note = explorer.querySelector<HTMLElement>('[data-sound-note]');
    const route = explorer.querySelector<HTMLAnchorElement>('[data-sound-route]');
    const scale = explorer.querySelector<HTMLElement>('.sound-scale');
    const markerHost = explorer.querySelector<HTMLElement>('.sound-markers');
    const band = explorer.querySelector<HTMLElement>('[data-range-band]');

    const select = (marker: HTMLButtonElement, animate = false) => {
      markers.forEach((item) => {
        const active = item === marker;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      if (name) name.textContent = marker.dataset.name ?? '';
      if (range) {
        // Lukema asettuu scramblella vain valinnasta, ei hiiren ohituksesta.
        const value = marker.dataset.range ?? '';
        if (animate) scrambleReading(range, value);
        else range.textContent = value;
      }
      if (description) description.textContent = marker.dataset.description ?? '';
      if (note) note.textContent = marker.dataset.note ?? '';
      if (route) {
        const target = marker.dataset.route ?? '';
        route.hidden = !target;
        route.href = target || '/sounds/';
      }
      if (markerHost && band) {
        // Vaihteluvälipalkki liukuu ja venyy asteikolla valitun äänen mukaan.
        markerHost.style.setProperty('--band-start', marker.dataset.bandStart ?? '0');
        markerHost.style.setProperty('--band-span', marker.dataset.bandSpan ?? '0');
        band.className = `range-band ${marker.dataset.risk ?? ''}`;
      }
      if (animate) {
        marker.classList.remove('is-pulsing');
        scale?.classList.remove('is-scanning');
        scale?.style.setProperty('--active-position', marker.style.getPropertyValue('--position'));
        requestAnimationFrame(() => {
          marker.classList.add('is-pulsing');
          scale?.classList.add('is-scanning');
        });
      }
    };

    markers.forEach((marker) => {
      marker.addEventListener('click', () => select(marker, true));
      marker.addEventListener('pointerenter', (event) => {
        if ((event as PointerEvent).pointerType !== 'touch') select(marker);
      });
    });
  });
</script>

<style>
  .sound-explorer {
    --sound-selection-duration: 900ms;
    --sound-selection-ease: cubic-bezier(.2,.7,.2,1);
    display: grid; gap: 20px;
  }
  .sound-scale {
    --active-position: 26%;
    position: relative; min-height: 250px; overflow-x: auto; overflow-y: hidden;
    border: 1px solid var(--ghost); border-radius: var(--radius-card);
    background: linear-gradient(180deg, rgba(255,255,255,.025), transparent), var(--surface);
    padding: 28px 24px 22px;
  }
  .sound-scale::after {
    content: ''; position: absolute; z-index: 0; top: 22px; bottom: 30px;
    left: clamp(24px, var(--active-position), calc(100% - 24px)); width: 1px;
    background: linear-gradient(to bottom, transparent, var(--on-surface-v) 22% 78%, transparent);
    opacity: 0; transform: scaleY(0); transform-origin: top; pointer-events: none;
  }
  .sound-scale.is-scanning::after {
    animation: scale-selection-scan var(--sound-selection-duration) var(--sound-selection-ease);
  }
  @keyframes scale-selection-scan {
    20% { opacity: .7; }
    70% { opacity: .5; transform: scaleY(1); }
    to { opacity: 0; transform: scaleY(1); }
  }
  /* Asteikko elää markkereiden koordinaatistossa, jotta numerot ja pisteet osuvat samoille kohdille. */
  .scale-track {
    position: absolute; left: 0; right: 0; bottom: 3px;
    height: 19px; padding-top: 9px;
    color: var(--muted-text); font: 10px/1 var(--font-data); letter-spacing: .08em;
  }
  .scale-track > span {
    position: absolute; top: 9px; left: var(--at);
    translate: -50% 0; white-space: nowrap;
  }
  .scale-track > span:first-child { translate: 0 0; }
  .scale-track > span:last-child { translate: -100% 0; }
  .scale-track::before {
    content: ''; position: absolute; right: 0; left: 0; top: 0; height: 1px;
    background: var(--outline-v); transform-origin: left;
  }
  .scale-track::after {
    content: ''; position: absolute; left: var(--exposure-limit-at); top: -1px; bottom: 17px;
    border-left: 1px solid color-mix(in srgb, var(--warning) 55%, transparent);
  }
  .sound-markers { position: relative; min-width: 720px; height: 174px; margin: 0 8px; }
  /* Valitun äänen tyypillinen vaihteluväli näyttää asteikolla alueen alun ja lopun. */
  .range-band {
    position: absolute; bottom: 21px;
    left: calc(var(--band-start) * 1%);
    width: max(6px, calc(var(--band-span) * 1%));
    height: 3px; border-radius: 999px;
    background: var(--secondary);
    transition: left 520ms var(--sound-selection-ease), width 520ms var(--sound-selection-ease), background 300ms ease;
  }
  .range-band::before, .range-band::after {
    content: ''; position: absolute; top: -3px;
    width: 1px; height: 10px; background: inherit;
  }
  .range-band::before { left: 0; }
  .range-band::after { right: 0; }
  .range-band.warning { background: var(--warning); }
  .range-band.danger { background: var(--error); }
  .sound-marker {
    position: absolute; left: var(--position); bottom: 22px; translate: -50% 0;
    display: grid; justify-items: center; gap: 9px; min-width: 46px; padding: 0;
    border: 0; background: transparent; color: var(--secondary);
    font: 11px/1.25 var(--font-data); cursor: pointer; white-space: nowrap;
  }
  .sound-marker[data-lane="middle"] { bottom: 82px; }
  .sound-marker[data-lane="top"] { bottom: 128px; }
  .marker-dot {
    position: relative; width: 11px; height: 11px; border-radius: 50%; background: var(--secondary);
    box-shadow: 0 0 0 5px var(--surface);
  }
  .marker-dot::after {
    content: ''; position: absolute; inset: -8px; border: 1px solid currentColor; border-radius: 50%;
    opacity: 0; transform: scale(.35); pointer-events: none;
  }
  .sound-marker.warning .marker-dot { background: var(--warning); }
  .sound-marker.danger .marker-dot { background: var(--error); }
  .sound-marker:hover, .sound-marker.active { color: var(--on-surface); }
  .sound-marker.active .marker-dot { box-shadow: 0 0 0 5px var(--surface), 0 0 0 7px currentColor; }
  .sound-marker.is-pulsing .marker-dot::after { animation: sound-marker-ping 700ms ease-out; }
  @media (min-width: 701px) {
    .sound-explorer.reveal.in .scale-track::before { animation: scale-line-draw 680ms cubic-bezier(.2,.7,.2,1) 80ms both; }
    .sound-explorer.reveal.in .scale-track > span { animation: scale-label-enter 260ms ease-out 620ms both; }
    .sound-explorer.reveal.in .sound-marker {
      animation: sound-marker-settle 540ms cubic-bezier(.18,.85,.25,1.15) both;
      animation-delay: calc(470ms + var(--marker-index) * 70ms);
    }
    .sound-explorer.reveal.in .range-band {
      animation: range-band-enter 520ms cubic-bezier(.2,.7,.2,1) 1080ms both;
    }
  }
  @keyframes range-band-enter { from { opacity: 0; scale: 0 1; } }
  @keyframes scale-line-draw { from { transform: scaleX(0); } }
  @keyframes scale-label-enter { from { opacity: 0; transform: translateY(4px); } }
  @keyframes sound-marker-settle {
    from { opacity: 0; transform: translateY(-28px) scale(.76); }
    72% { opacity: 1; transform: translateY(3px) scale(1.06); }
    to { opacity: 1; transform: none; }
  }
  @keyframes sound-marker-ping { 35% { opacity: .8; } to { opacity: 0; transform: scale(1.75); } }
  .sound-marker:focus-visible { outline: 2px solid var(--on-surface); outline-offset: 7px; border-radius: 4px; }
  .sound-detail {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; overflow: hidden;
    padding: 28px; border: 1px solid var(--ghost); border-radius: var(--radius-card); background: var(--surface-c);
  }
  .detail-category { color: var(--muted-text); font: 10px/1 var(--font-data); letter-spacing: .12em; text-transform: uppercase; }
  .sound-detail h3 { margin: 8px 0; font-size: 24px; }
  .sound-detail p { max-width: 680px; margin: 0; color: var(--on-surface-v); }
  .sound-detail .exposure-note { margin-top: 8px; color: var(--secondary); font-size: 14px; }
  .detail-reading { display: grid; gap: 12px; justify-items: end; }
  .detail-reading strong { font: 600 24px/1 var(--font-data); white-space: nowrap; }
  .detail-reading a { color: var(--on-surface-v); font-size: 14px; text-underline-offset: 4px; }
  .sound-disclaimer { margin: 0; color: var(--muted-text); font-size: 12px; }
  .sound-sources { color: var(--on-surface-v); font-size: 13px; }
  .sound-sources summary {
    width: fit-content; color: var(--on-surface); font-weight: 600; cursor: pointer; text-underline-offset: 4px;
  }
  .sound-sources summary:focus-visible,
  .sound-sources a:focus-visible { outline: 2px solid var(--on-surface); outline-offset: 4px; border-radius: 2px; }
  .sound-sources-content { display: grid; gap: 14px; padding-top: 12px; }
  .sound-sources-content > p { margin: 0; color: var(--muted-text); }
  .sound-sources ul { display: grid; gap: 14px; margin: 0; padding-left: 20px; }
  .sound-sources li p { margin: 0; }
  .sound-sources li strong { color: var(--on-surface); }
  .source-citation { margin-top: 4px !important; color: var(--muted-text); font-size: 12px; }
  .source-citation a { color: var(--on-surface-v); text-underline-offset: 3px; }
  .mobile-sound-view { display: none; }
  .compact .sound-scale { min-height: 230px; }
  @media (max-width: 700px) {
    .sound-scale { margin-inline: -20px; border-radius: 0; border-inline: 0; padding-inline: 20px; }
    .sound-detail { grid-template-columns: 1fr; align-items: start; gap: 20px; padding: 22px; }
    .detail-reading { justify-items: start; }
    .sound-explorer:not(.compact) .sound-scale,
    .sound-explorer:not(.compact) .sound-detail { display: none; }
    .sound-explorer:not(.compact) .mobile-sound-view {
      display: grid; margin-inline: -20px; border-block: 1px solid var(--ghost); background: var(--surface);
    }
    .mobile-scale-key {
      display: flex; justify-content: space-between; padding: 10px 20px 8px;
      color: var(--muted-text); font: 10px/1 var(--font-data); letter-spacing: .08em;
    }
    .mobile-sound-list { display: grid; list-style: none; margin: 0; padding: 0; }
    .mobile-sound-list > li + li { border-top: 1px solid var(--ghost); }
    .mobile-sound-list details[open] { background: var(--surface-c); }
    .mobile-sound-list summary {
      position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto 10px;
      gap: 8px 12px; align-items: center; min-height: 62px; padding: 12px 20px;
      color: var(--on-surface-v); cursor: pointer; list-style: none;
    }
    .mobile-sound-list summary::-webkit-details-marker { display: none; }
    .mobile-sound-list summary:focus-visible { outline: 2px solid var(--on-surface); outline-offset: -4px; }
    .mobile-risk-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--secondary); }
    .mobile-risk-dot.warning { background: var(--warning); }
    .mobile-risk-dot.danger { background: var(--error); }
    .mobile-sound-name { overflow: hidden; color: var(--on-surface); font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
    .mobile-sound-list summary strong { font: 500 12px/1 var(--font-data); white-space: nowrap; }
    .mobile-disclosure {
      width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
      rotate: 45deg; transition: rotate 160ms ease;
    }
    details[open] .mobile-disclosure { rotate: 225deg; }
    .mobile-range-track {
      position: relative; grid-column: 2 / -1; height: 3px; overflow: hidden;
      border-radius: 999px; background: var(--ghost);
    }
    .mobile-range-fill {
      position: absolute; inset-block: 0; left: var(--range-start); width: calc(var(--range-end) - var(--range-start));
      min-width: 5px; border-radius: inherit; background: var(--secondary);
    }
    .sound-explorer.reveal.in .mobile-range-fill {
      animation: mobile-range-enter 420ms cubic-bezier(.2,.7,.2,1) both;
      animation-delay: calc(var(--sound-index) * 40ms); transform-origin: left;
    }
    @keyframes mobile-range-enter { from { opacity: 0; transform: scaleX(0); } }
    .mobile-range-fill.warning { background: var(--warning); }
    .mobile-range-fill.danger { background: var(--error); }
    .mobile-sound-detail { display: grid; gap: 8px; padding: 0 20px 16px 42px; }
    details[open] .mobile-sound-detail { animation: mobile-detail-enter 180ms ease-out; }
    @keyframes mobile-detail-enter { from { opacity: 0; transform: translateY(-5px); } }
    .mobile-sound-detail p { margin: 0; color: var(--on-surface-v); font-size: 14px; }
    .mobile-sound-detail .mobile-exposure-note { color: var(--secondary); font-size: 13px; }
    .mobile-sound-detail a { justify-self: start; margin-top: 4px; color: var(--on-surface); font-size: 14px; font-weight: 600; text-underline-offset: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sound-explorer.reveal.in .sound-marker,
    .sound-marker.is-pulsing .marker-dot::after,
    .sound-scale.is-scanning::after,
    .sound-explorer.reveal.in .scale-track::before,
    .sound-explorer.reveal.in .scale-track > span,
    .sound-explorer.reveal.in .mobile-range-fill,
    details[open] .mobile-sound-detail { animation: none; }
    .range-band { animation: none; transition: none; }
  }
</style>
