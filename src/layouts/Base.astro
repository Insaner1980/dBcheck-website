---
import { socialImages, type SocialImage } from '../data/social';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { defaultLocale, isLocale, localeTags, openGraphLocales, type Locale } from '../i18n/config';
import { alternatesForPath, findRoutePair, type AlternateLink } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  socialImage?: SocialImage;
  locale?: Locale;
  alternates?: AlternateLink[];
  /** Omits route-specific sharing and indexing metadata from a true error document. */
  errorDocument?: boolean;
  /** Näyttää lukemisen edistymisviivan headerin alareunassa. Vain pitkille sisältösivuille. */
  readingProgress?: boolean;
  /** Optional same-origin stylesheet required by this page's generated content. */
  stylesheet?: string;
}
const {
  title,
  description = 'dBcheck is an Android sound awareness meter with free educational sound tools and personal relative hearing-result tracking.',
  ogType = 'website',
  jsonLd = [],
  socialImage = socialImages.app,
  locale: localeProp,
  alternates: alternateProp,
  errorDocument = false,
  readingProgress = false,
  stylesheet,
} = Astro.props;
const locale = localeProp ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale);
const copy = getUi(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = errorDocument ? [] : (alternateProp ?? alternatesForPath(Astro.url.pathname));
const isLocalized = locale !== defaultLocale;
const localizedRoute = (defaultPath: string) => findRoutePair(defaultPath)?.[locale] ?? defaultPath;
const toolsRoute = localizedRoute('/tools/');
const articlesRoute = localizedRoute('/articles/');
const isCurrentSection = (route: string) => Astro.url.pathname.startsWith(route);
const showSearch = isCurrentSection(toolsRoute) || isCurrentSection(articlesRoute);
const searchIndexUrl = isLocalized ? `/${locale}/search.json` : '/search.json';
const socialImageUrl = new URL(socialImage.src, Astro.site);
const serializeJsonLd = (value: Record<string, unknown>) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#080808" />
  {errorDocument && <meta name="robots" content="noindex" />}
  {!errorDocument && <link rel="canonical" href={canonical} />}
  {alternates.map((alternate) => <link rel="alternate" hreflang={localeTags[alternate.locale]} href={new URL(alternate.href, Astro.site)} />)}
  {alternates.some((alternate) => alternate.locale === 'en') && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find((alternate) => alternate.locale === 'en')!.href, Astro.site)} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" href="/dbcheck-logo.svg?v=2" type="image/svg+xml" sizes="any" />
  {!errorDocument && <>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImage.alt[locale]} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImage.alt[locale]} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(item)} />)}
  </>}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Instrument+Sans:wght@400..700&display=swap" rel="stylesheet" media="print" onload="this.setAttribute('media', 'all')" />
  {stylesheet && <link rel="stylesheet" href={stylesheet} />}
</head>
<body>
  <a class="skip-link" href="#main">{copy.skip}</a>

  <header class="site-header">
    <nav class="nav" aria-label={copy.mainNav}>
      <a class="wordmark" href="/" aria-label="dBcheck" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
        <img class="brand-logo" src="/dbcheck-logo.svg" alt="" />
        <span class="brand-name">dB<em>check</em></span>
      </a>
      <button class="menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-links">
        <span class="menu-label">{copy.menu}</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
      <div class="nav-links" id="primary-links">
        {isLocalized ? <>
          <a href={toolsRoute} aria-current={isCurrentSection(toolsRoute) ? 'page' : undefined}>{copy.tools}</a><a href={articlesRoute} aria-current={isCurrentSection(articlesRoute) ? 'page' : undefined}>{copy.articles}</a>
        </> : <>
          <a href={toolsRoute} aria-current={isCurrentSection(toolsRoute) ? 'page' : undefined}>Tools</a><a href="/#features">Features</a><a href="/#pricing">Pricing</a><a href={articlesRoute} aria-current={isCurrentSection(articlesRoute) ? 'page' : undefined}>Articles</a>
        </>}
      </div>
      {Astro.url.pathname !== '/' && !isLocalized && <LanguageSwitcher locale={locale} alternates={alternates} />}
      {showSearch && (
        <button class="search-btn" id="search-open" aria-label={copy.search} title={`${copy.search} ( / )`}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
        </button>
      )}
    </nav>
    {readingProgress && <div class="reading-progress" aria-hidden="true"></div>}
  </header>

  {showSearch && (
    <dialog class="search-overlay" id="search-overlay" aria-labelledby="search-title" data-search-index={searchIndexUrl} closedby="any" hidden>
      <div class="search-panel">
        <div class="search-head">
          <span class="search-kicker" id="search-title">{copy.searchTitle}</span>
          <button class="search-close" id="search-close" aria-label={copy.closeSearch}>ESC</button>
        </div>
        <label class="search-label" for="search-input">{copy.searchLabel}</label>
        <input id="search-input" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" spellcheck="false" autofocus />
        <div class="search-scale" aria-hidden="true">
          <span>0</span><span>25</span><span>50</span><span>75</span><span>100</span><span>130 dB</span>
        </div>
        <ul id="search-results" class="search-results"></ul>
        <p id="search-empty" class="search-empty" hidden>{copy.searchEmpty}</p>
        <div id="search-error" class="search-empty" hidden>
          <span>{copy.searchError}{' '}</span>
          <button class="search-retry" id="search-retry" type="button">{copy.retrySearch}</button>
        </div>
        <span
          class="search-announcement"
          data-search-announcement
          data-result-one={copy.searchResult}
          data-result-many={copy.searchResults}
          data-no-results={copy.searchEmpty}
          data-error={copy.searchError}
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></span>
      </div>
    </dialog>
  )}

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-wordmark">
          <img class="brand-logo brand-logo--footer" src="/dbcheck-logo.svg" alt="" />
          <span class="brand-name brand-name--footer">dB<em>check</em></span>
        </div>
        <p>{copy.footerTagline.split('\n').map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</p>
      </div>
      <div class="footer-col">
        <span class="footer-label">{copy.footerExplore}</span>
        {locale === 'de' ? <>
          <a href="/de/werkzeuge/">{copy.tools}</a><a href="/de/artikel/">{copy.articles}</a>
        </> : <>
          <a href="/tools/">Tools</a><a href="/#features">Features</a><a href="/#pricing">Pricing</a><a href="/articles/">Articles</a>
        </>}
      </div>
      <div class="footer-col">
        <span class="footer-label">{copy.footerFinnvek}</span>
        <a href="https://finnvek.com/about/">{copy.aboutMaker}</a>
        <a href="https://finnvek.com/#apps">{copy.otherApps}</a>
        <a href="mailto:contact@finnvek.com">{copy.contact}</a>
      </div>
    </div>
    <div class="footer-meta">
      <span>© {new Date().getFullYear()} dBcheck</span>
      <span>{copy.disclaimer.split('\n').map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</span>
    </div>
  </footer>

  <script>
    const prefersReduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Mobile navigation ----
    const menuToggle = document.getElementById('menu-toggle');
    const primaryLinks = document.getElementById('primary-links');
    const setMenuOpen = (open: boolean) => {
      menuToggle?.setAttribute('aria-expanded', String(open));
      primaryLinks?.classList.toggle('open', open);
    };
    menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
    primaryLinks?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

    // ---- Shared heading transition ----
    type PendingHeadingTransition = { heading: HTMLElement; destination: string };
    let pendingHeadingTransition: PendingHeadingTransition | null = null;

    document.addEventListener('click', (event) => {
      pendingHeadingTransition = null;
      if (!(event instanceof MouseEvent) || event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;

      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="/"]');
      if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;

      const card = link.closest('.article-group li, .tool-card');
      const heading = card?.querySelector<HTMLElement>('h2, h3, strong');
      if (!heading) return;
      pendingHeadingTransition = { heading, destination: link.href };
    });

    window.addEventListener('pageswap', (event) => {
      const pending = pendingHeadingTransition;
      pendingHeadingTransition = null;
      const pageSwap = event as Event & {
        activation?: { entry?: { url?: string } };
        viewTransition?: { finished: Promise<unknown> };
      };
      if (!pending || !pending.heading.isConnected || pageSwap.activation?.entry?.url !== pending.destination || !pageSwap.viewTransition) return;

      const pageHeading = document.querySelector<HTMLElement>('main h1');
      pageHeading?.style.setProperty('view-transition-name', 'none');
      pending.heading.style.setProperty('view-transition-name', 'page-heading');

      const clearNames = () => {
        pageHeading?.style.removeProperty('view-transition-name');
        pending.heading.style.removeProperty('view-transition-name');
      };
      void pageSwap.viewTransition.finished.then(clearNames, clearNames);
    });

    // ---- Search overlay ----
    const overlay = document.getElementById('search-overlay') as HTMLDialogElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsEl = document.getElementById('search-results');
    const emptyEl = document.getElementById('search-empty');
    const errorEl = document.getElementById('search-error');
    const searchAnnouncement = document.querySelector<HTMLElement>('[data-search-announcement]');
    type SearchEntry = { title: string; description: string; tags: string[]; url: string; kind: string };
    let index: SearchEntry[] | null = null;
    let indexLoad: Promise<SearchEntry[] | null> | null = null;
    let searchTrigger: HTMLElement | null = null;
    let searchSession = 0;
    let searchGeneration = 0;
    let searchAnnouncementTimer: ReturnType<typeof setTimeout> | undefined;
    const searchRequestTimeout = 8000;
    const isSearchEntry = (value: unknown): value is SearchEntry => {
      if (!value || typeof value !== 'object') return false;
      const entry = value as Partial<SearchEntry>;
      return typeof entry.title === 'string'
        && typeof entry.description === 'string'
        && Array.isArray(entry.tags)
        && entry.tags.every((tag) => typeof tag === 'string')
        && typeof entry.url === 'string'
        && typeof entry.kind === 'string';
    };

    const announceSearch = (message: string) => {
      if (!searchAnnouncement) return;
      if (searchAnnouncementTimer !== undefined) clearTimeout(searchAnnouncementTimer);
      searchAnnouncement.textContent = '';
      if (!message) {
        searchAnnouncementTimer = undefined;
        return;
      }
      searchAnnouncementTimer = setTimeout(() => {
        if (overlay?.open) searchAnnouncement.textContent = message;
        searchAnnouncementTimer = undefined;
      }, 200);
    };

    const showSearchError = () => {
      resultsEl?.replaceChildren();
      if (emptyEl) emptyEl.hidden = true;
      if (errorEl) errorEl.hidden = false;
      announceSearch(searchAnnouncement?.dataset.error ?? '');
    };
    function loadIndex(): Promise<SearchEntry[] | null> {
      if (index) return Promise.resolve(index);
      if (indexLoad) return indexLoad;
      const pending = Promise.resolve().then(async () => {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), searchRequestTimeout);
        try {
          const res = await fetch(overlay?.dataset.searchIndex ?? '/search.json', { signal: controller.signal });
          if (!res.ok) throw new Error(`Search index request failed: ${res.status}`);
          const loadedIndex = await res.json();
          if (!Array.isArray(loadedIndex) || !loadedIndex.every(isSearchEntry)) {
            throw new Error('Search index response contains invalid entries.');
          }
          index = loadedIndex;
          return index;
        } finally {
          clearTimeout(timeout);
        }
      }).catch((error) => {
        index = null;
        console.error('Unable to load the search index.', error);
        return null;
      }).finally(() => { indexLoad = null; });
      indexLoad = pending;
      return pending;
    }
    const internalSearchHref = (value: string) => {
      try {
        const candidate = value.trim();
        if (candidate.startsWith('//')) return null;
        const url = new URL(candidate, window.location.origin);
        if ((url.protocol !== 'http:' && url.protocol !== 'https:') || url.origin !== window.location.origin) return null;
        return `${url.pathname}${url.search}${url.hash}`;
      } catch {
        return null;
      }
    };
    const normalizeSearchText = (value: string) => value.trim().toLocaleLowerCase(document.documentElement.lang).replaceAll('ß', 'ss');
    function renderSearchResults(data: SearchEntry[], query: string) {
      if (!resultsEl || !emptyEl) return;
      errorEl?.setAttribute('hidden', '');
      resultsEl.replaceChildren();
      const normalizedQuery = normalizeSearchText(query);
      if (!normalizedQuery) {
        emptyEl.hidden = true;
        announceSearch('');
        return;
      }
      const hits = data.filter((d) =>
        normalizeSearchText(d.title).includes(normalizedQuery) ||
        normalizeSearchText(d.description).includes(normalizedQuery) ||
        d.tags.some((t) => normalizeSearchText(t).includes(normalizedQuery))
      ).map((hit) => ({ hit, href: internalSearchHref(hit.url) })).filter((entry): entry is { hit: SearchEntry; href: string } => entry.href !== null).slice(0, 12);
      emptyEl.hidden = hits.length > 0;
      for (const [hitIndex, { hit, href }] of hits.entries()) {
        const li = document.createElement('li');
        li.style.setProperty('--hit-index', String(hitIndex));
        const a = document.createElement('a');
        a.href = href;
        const kind = document.createElement('span');
        kind.className = 'hit-kind';
        kind.textContent = hit.kind;
        const title = document.createElement('span');
        title.className = 'hit-title';
        title.textContent = hit.title;
        const desc = document.createElement('span');
        desc.className = 'hit-desc';
        desc.textContent = hit.description;
        a.append(kind, title, desc);
        li.appendChild(a);
        resultsEl.appendChild(li);
      }
      announceSearch(
        hits.length === 0
          ? searchAnnouncement?.dataset.noResults ?? ''
          : hits.length === 1
            ? searchAnnouncement?.dataset.resultOne ?? ''
            : `${hits.length} ${searchAnnouncement?.dataset.resultMany ?? ''}`.trim(),
      );
    }
    const isCurrentSearch = (session: number, generation: number) =>
      overlay?.open && session === searchSession && generation === searchGeneration;
    async function searchCurrentQuery() {
      const session = searchSession;
      const generation = ++searchGeneration;
      const data = await loadIndex();
      if (!isCurrentSearch(session, generation)) return;
      if (!data) {
        showSearchError();
        return;
      }
      renderSearchResults(data, input?.value ?? '');
    }

    function openSearch() {
      if (!overlay || overlay.open || typeof overlay.showModal !== 'function') return false;
      const wasHidden = overlay.hidden;
      const wasClosing = overlay.classList.contains('is-closing');
      const bodyWasSearchOpen = document.body.classList.contains('search-open');
      const focusedBeforeOpening = document.activeElement as HTMLElement | null;
      const restoreFailedOpen = () => {
        try {
          if (overlay.open) overlay.close();
        } catch {
          // The dialog did not open cleanly, so keep the page usable without search.
        }
        overlay.hidden = wasHidden;
        overlay.classList.toggle('is-closing', wasClosing);
        document.body.classList.toggle('search-open', bodyWasSearchOpen);
      };
      try {
        overlay.hidden = false;
        overlay.classList.remove('is-closing');
        overlay.showModal();
        if (!overlay.open) {
          restoreFailedOpen();
          return false;
        }
      } catch {
        restoreFailedOpen();
        return false;
      }
      searchTrigger = focusedBeforeOpening;
      const session = ++searchSession;
      document.body.classList.add('search-open');
      void searchCurrentQuery();
      requestAnimationFrame(() => {
        if (overlay.open && session === searchSession) input?.focus();
      });
      return true;
    }
    function closeSearch() {
      if (!overlay?.open || overlay.classList.contains('is-closing')) return;
      searchSession += 1;
      let settled = false;
      let fallbackTimer: ReturnType<typeof setTimeout> | undefined;
      const panel = overlay.querySelector('.search-panel');
      const onAnimationFinish = (event: AnimationEvent) => {
        if (event.target !== panel) return;
        finish();
      };
      const finish = () => {
        if (settled) return;
        settled = true;
        if (fallbackTimer !== undefined) clearTimeout(fallbackTimer);
        panel?.removeEventListener('animationend', onAnimationFinish as EventListener);
        panel?.removeEventListener('animationcancel', onAnimationFinish as EventListener);
        if (overlay.open) overlay.close();
        overlay.classList.remove('is-closing');
      };
      if (prefersReduced() || !panel) {
        finish();
        return;
      }
      overlay.classList.add('is-closing');
      panel.addEventListener('animationend', onAnimationFinish as EventListener);
      panel.addEventListener('animationcancel', onAnimationFinish as EventListener);
      fallbackTimer = setTimeout(finish, 240);
    }

    document.getElementById('search-open')?.addEventListener('click', openSearch);
    document.getElementById('search-close')?.addEventListener('click', closeSearch);
    document.getElementById('search-retry')?.addEventListener('click', () => void searchCurrentQuery());
    overlay?.addEventListener('click', (event) => {
      if (event.target === overlay) closeSearch();
    });
    overlay?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeSearch();
    });
    overlay?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || event.defaultPrevented) return;
      const focusable = Array.from(overlay.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )).filter((element) => element.getClientRects().length > 0 && !element.closest('[hidden], [inert]'));
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    if (overlay?.open) overlay.close();
    if (overlay) overlay.hidden = true;
    overlay?.addEventListener('close', () => {
      if (overlay.open) return;
      overlay.hidden = true;
      document.body.classList.remove('search-open');
      if (searchAnnouncementTimer !== undefined) clearTimeout(searchAnnouncementTimer);
      searchAnnouncementTimer = undefined;
      if (searchAnnouncement) searchAnnouncement.textContent = '';
      const isVisibleFocusTarget = (element: HTMLElement | null) =>
        Boolean(element?.isConnected
          && element.matches('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), summary, [tabindex]:not([tabindex="-1"])')
          && element.getClientRects().length > 0
          && !element.closest('[hidden], [inert]'));
      const defaultTrigger = document.getElementById('search-open');
      const restoreTarget = isVisibleFocusTarget(searchTrigger) ? searchTrigger : defaultTrigger;
      if (isVisibleFocusTarget(restoreTarget)) restoreTarget?.focus();
      searchTrigger = null;
    });
    const isSearchTextEntry = (target: EventTarget) => {
      if (!(target instanceof Element)) return false;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return true;
      if (target instanceof HTMLElement && target.isContentEditable) return true;
      return target.getAttribute('role')?.split(/\s+/).some((role) => ['textbox', 'searchbox', 'combobox'].includes(role)) ?? false;
    };
    const isLegacyImeKey = (event: KeyboardEvent) => (event as { keyCode: number }).keyCode === 229;
    document.addEventListener('keydown', (e) => {
      if (!overlay || overlay.open || e.key !== '/' || e.defaultPrevented || e.isComposing || isLegacyImeKey(e) || e.ctrlKey || e.metaKey || e.altKey || e.getModifierState('AltGraph') || e.composedPath().some(isSearchTextEntry)) return;
      if (openSearch()) e.preventDefault();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || event.isComposing || isLegacyImeKey(event) || !overlay?.open) return;
      event.preventDefault();
      closeSearch();
    });

    // ---- Scroll reveal ----
    // Pidä lista synkassa sivupohjien kanssa: kuollut valitsin ei tee mitään,
    // mutta puuttuva jättää kokonaisen sivutyypin ilman sisääntuloa.
    const revealSelectors = [
      '.hero-copy', '.hero-hud', '.section-head', '.why-card', '.plan',
      '.cta-inner', '.page-head', '.privacy-note', '.sound-explorer',
      '.exposure-calculator', '.tool-card', '.sound-list li',
      '.free-feature-item', '.feature-tier-head', '.pro-feature-showcase',
      '.article-group > header', '.article-group li',
      '.editorial-head', '.sound-summary', '.related', '.article-cta',
    ];
    const revealEls = Array.from(document.querySelectorAll(revealSelectors.join(',')));
    const showRevealFallback = () => revealEls.forEach((el) => el.classList.add('in'));
    revealEls.forEach((el) => el.classList.add('reveal'));
    if (prefersReduced() || !('IntersectionObserver' in window)) {
      showRevealFallback();
    } else {
      try {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            const siblings = Array.from(el.parentElement?.children ?? [])
              .filter((c) => c.classList.contains('reveal') && !c.classList.contains('in'));
            const idx = Math.max(0, siblings.indexOf(el));
            el.style.transitionDelay = `${Math.min(idx, 7) * 80}ms`;
            el.classList.add('in');
            io.unobserve(el);
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -48px 0px' });
        revealEls.forEach((el) => io.observe(el));
      } catch (error) {
        console.error('Unable to initialize scroll reveal; showing content instead.', error);
        showRevealFallback();
      }
    }

    // ---- Live result motion ----
    if (!prefersReduced() && 'MutationObserver' in window) {
      try {
        const resultFrames = new WeakMap<Element, number>();
        document.querySelectorAll('.calculator-result strong').forEach((output) => {
          const observer = new MutationObserver(() => {
            const result = output.closest('.calculator-result');
            if (!result) return;
            const pendingFrame = resultFrames.get(result);
            if (pendingFrame) cancelAnimationFrame(pendingFrame);
            result.classList.remove('result-updated');
            resultFrames.set(result, requestAnimationFrame(() => {
              result.classList.add('result-updated');
              resultFrames.delete(result);
            }));
          });
          observer.observe(output, { childList: true, characterData: true, subtree: true });
        });
      } catch (error) {
        console.error('Unable to initialize result update motion; continuing without it.', error);
      }
    }

    input?.addEventListener('input', () => void searchCurrentQuery());
  </script>

  <style is:global>
    @view-transition { navigation: auto; }

    :root {
      /* dBcheck dark theme tokens (from app UI spec) */
      --bg: #080808;
      --surface: #101010;
      --surface-c: #171717;
      --surface-ch: #202020;
      --surface-chh: #2A2A2A;
      --on-surface: #F5F5F5;
      --on-surface-v: #B8B8B8;
      --primary: #F7F7F7;
      --primary-dim: #CFCFCF;
      --secondary: #8F8F8F;
      --tertiary: #5E5E5E;
      --muted-text: #888888;
      --outline-v: #8C8C8C;
      --ghost: rgba(140, 140, 140, 0.15);
      --result-border-color: var(--on-surface);
      --error: #E07A7A;
      --warning: #C9A24D;
      --success: #8EA58E;
      --font-body: 'Instrument Sans', system-ui, sans-serif;
      --font-data: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
      --font-size-page-title: clamp(2.625rem, 7vw, 4.125rem);
      --radius-card: 24px;
      --radius-tile: 14px;
      --max-w: 1120px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--on-surface);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: var(--on-surface); color: var(--bg); }
    a { color: inherit; }
    :where(a, button, input, summary):focus-visible { outline: 2px solid var(--on-surface); outline-offset: 4px; }
    .page-head,
    .editorial-head,
    .tool-card,
    .page-head > *,
    .editorial-head > *,
    .tool-card > * { min-width: 0; }
    :where(h1, h2, h3, h4, h5, h6) {
      word-break: normal;
      overflow-wrap: break-word;
      hyphens: auto;
    }
    :where(code, kbd, samp, var, .katex) {
      word-break: normal;
      overflow-wrap: normal;
      hyphens: none;
    }
    .skip-link {
      position: absolute; left: -999px; top: 0;
      background: var(--on-surface); color: var(--bg);
      padding: 8px 16px; z-index: 100; border-radius: 0 0 8px 0;
    }
    .skip-link:focus { left: 0; }

    /* Teknisten tunnisteiden ja mittausdatan yhtenäinen typografia. */
    .kicker {
      font-family: var(--font-data);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--secondary);
    }

    /* ---- Motion ---- */
    @keyframes page-exit {
      to { opacity: 0; transform: translateY(-8px); }
    }
    @keyframes page-enter {
      from { opacity: 0; transform: translateY(10px); }
    }
    ::view-transition-old(root) { animation: page-exit 160ms ease-in both; }
    ::view-transition-new(root) { animation: page-enter 280ms cubic-bezier(.2,.7,.2,1) both; }
    ::view-transition-group(page-heading) { animation-duration: 380ms; animation-timing-function: cubic-bezier(.2,.7,.2,1); }
    main h1 { view-transition-name: page-heading; }

    .reveal {
      opacity: 0;
      translate: 0 26px;
      transition: opacity 700ms cubic-bezier(0.2, 0.6, 0.2, 1), translate 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    .reveal.in { opacity: 1; translate: 0 0; }

    /* Korttien hover-nosto. Transition on yksi ominaisuus: jos nämä elementit
       määrittelevät sen uudelleen, revealin siirtymä katoaa kokonaan ja kortti
       ilmestyy nytkähtäen. Siksi kaikki tarvittavat siirtymät ovat tässä yhdessä
       määrittelyssä, ja nosto käyttää transformia jottei se kilpaile revealin
       translaten kanssa. */
    .why-card, .plan, .tool-card {
      transition:
        opacity 700ms cubic-bezier(0.2, 0.6, 0.2, 1),
        translate 700ms cubic-bezier(0.2, 0.6, 0.2, 1),
        transform 250ms ease,
        background 200ms ease,
        border-color 200ms ease;
    }
    .why-card:hover, .plan:hover { transform: translateY(-4px); }

    /* Hintakortti täyttää pienen näytön lähes kokonaan, jolloin koko lohkon siirtymä
       lukisi nytkähdyksenä. Kortti paljastuu paikallaan ja sisältö tulee porrastettuna. */
    .plan.reveal { translate: none; }

    .calculator-result.result-updated strong { animation: result-value-enter 220ms cubic-bezier(.2,.7,.2,1); }
    @keyframes result-value-enter {
      from { opacity: .3; transform: translateY(7px); }
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
      html { scroll-behavior: auto; }
      .reveal { opacity: 1; translate: none; transition: none; }
      .why-card:hover, .plan:hover { transform: none; }
      .calculator-result.result-updated strong { animation: none; }
      .search-panel, .search-results li { animation: none !important; }
      body.search-open .search-btn { scale: 1; opacity: 1; }
    }

    /* ---- Header ---- */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: rgba(8, 8, 8, 0.82);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--ghost);
    }
    /* Lukemisen edistymisviiva. Ei itsenäistä liikettä — se on suora lukema
       vierityskohdasta, joten se jää näkyviin myös reduced motion -asetuksella.
       Ilman scroll-aikajanan tukea viiva jää näkymättömiin. */
    .reading-progress {
      position: absolute; right: 0; bottom: -1px; left: 0; height: 2px;
      background: var(--primary);
      transform-origin: 0 50%;
      scale: 0 1;
    }
    @supports (animation-timeline: scroll()) {
      .reading-progress {
        animation-name: reading-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        /* auto = koko aikajanan mitta; animation-lyhenne asettaisi keston nollaksi. */
        animation-duration: auto;
        animation-timeline: scroll(root block);
      }
    }
    @keyframes reading-progress { to { scale: 1 1; } }
    .nav {
      max-width: var(--max-w);
      margin: 0 auto;
      display: flex; align-items: center; gap: 32px;
      padding: 14px 20px;
    }
    .wordmark {
      display: inline-flex; align-items: center; gap: 10px;
      text-decoration: none;
    }
    .brand-logo { display: block; width: 20px; height: 20px; margin: 8px; }
    .brand-name { font-family: var(--font-body); font-weight: 600; font-size: 18px; letter-spacing: normal; }
    .brand-name em { font-style: normal; color: var(--secondary); }
    .footer-wordmark { display: flex; align-items: center; gap: 8px; }
    .brand-name--footer { font-size: 16px; }
    .nav-links { display: flex; gap: 24px; margin-left: auto; }
    .nav-links a {
      text-decoration: none;
      font-size: 14px; font-weight: 500;
      color: var(--on-surface-v);
      transition: color 160ms ease;
    }
    .nav-links a:hover { color: var(--on-surface); }
    .nav-links a[aria-current='page'] { color: var(--on-surface); }
    @media (forced-colors: active) {
      .nav a[aria-current='page'] {
        text-decoration-line: underline;
        text-decoration-style: solid;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.3em;
        text-decoration-color: currentColor;
      }
    }
    .menu-btn { display: none !important; }
    .search-btn {
      display: grid; place-items: center;
      width: 40px; height: 40px;
      border-radius: 999px;
      border: 1px solid var(--ghost);
      background: transparent; color: var(--on-surface-v);
      cursor: pointer;
      transition: color 160ms ease, border-color 160ms ease, scale 180ms ease, opacity 180ms ease;
    }
    .search-btn:hover { color: var(--on-surface); border-color: var(--outline-v); }
    body.search-open .search-btn { scale: .86; opacity: .35; }

    /* ---- Search overlay ---- */
    .search-overlay {
      position: fixed; inset: 0; z-index: 90; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0;
      border: 0;
      background: rgba(8, 8, 8, 0.72);
      backdrop-filter: blur(8px);
      display: flex; justify-content: center;
      padding: 12vh 20px 40px;
      color: var(--on-surface);
    }
    .search-overlay[hidden] { display: none !important; }
    .search-overlay:not([open]) { display: none; }
    .search-overlay::backdrop { background: transparent; }
    .search-panel {
      width: 100%; max-width: 640px; height: fit-content;
      background: var(--surface-c);
      border: 1px solid var(--ghost);
      border-radius: var(--radius-card);
      padding: 24px;
      transform-origin: calc(100% - 24px) 0;
      animation: search-panel-enter 280ms cubic-bezier(.16,.8,.2,1) both;
    }
    .search-overlay.is-closing .search-panel { animation: search-panel-exit 160ms ease-in both; }
    @keyframes search-panel-enter {
      from { opacity: 0; transform: translate(18px, -18px) scale(.82); }
    }
    @keyframes search-panel-exit {
      to { opacity: 0; transform: translate(18px, -18px) scale(.9); }
    }
    .search-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .search-kicker { font-family: var(--font-data); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--secondary); }
    .search-label { display: block; margin-bottom: 8px; color: var(--on-surface-v); font-size: 13px; font-weight: 600; }
    .search-close {
      font-family: var(--font-data); font-size: 11px; letter-spacing: 0.08em;
      background: var(--surface-chh); color: var(--on-surface-v);
      border: none; border-radius: 6px; padding: 6px 10px; cursor: pointer;
    }
    #search-input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--ghost);
      border-radius: 12px;
      color: var(--on-surface);
      font-family: var(--font-body); font-size: 18px;
      padding: 14px 16px;
    }
    #search-input:focus { border-color: rgba(247, 247, 247, 0.3); }
    #search-input::-webkit-search-cancel-button {
      appearance: none;
      width: 18px;
      height: 18px;
      cursor: pointer;
      background:
        linear-gradient(45deg, transparent 45%, var(--on-surface-v) 46% 54%, transparent 55%),
        linear-gradient(-45deg, transparent 45%, var(--on-surface-v) 46% 54%, transparent 55%);
    }
    #search-input:hover::-webkit-search-cancel-button {
      background:
        linear-gradient(45deg, transparent 45%, var(--on-surface) 46% 54%, transparent 55%),
        linear-gradient(-45deg, transparent 45%, var(--on-surface) 46% 54%, transparent 55%);
    }
    .search-scale {
      display: flex; justify-content: space-between;
      margin: 10px 4px 6px;
      font-family: var(--font-data); font-size: 10px; letter-spacing: 0.08em;
      color: var(--muted-text);
    }
    .search-results {
      list-style: none; margin: 8px 0 0; padding: 0; max-height: 44vh; overflow-y: auto;
      scrollbar-color: var(--secondary) var(--surface);
      scrollbar-width: thin;
    }
    .search-results::-webkit-scrollbar { width: 10px; }
    .search-results::-webkit-scrollbar-track { background: var(--surface); border-radius: 999px; }
    .search-results::-webkit-scrollbar-thumb {
      background: var(--secondary);
      border: 3px solid var(--surface);
      border-radius: 999px;
    }
    .search-results::-webkit-scrollbar-thumb:hover { background: var(--on-surface-v); }
    .search-results a {
      display: grid; gap: 2px;
      padding: 12px 14px; border-radius: var(--radius-tile);
      text-decoration: none;
    }
    .search-results a:hover { background: var(--surface-ch); }
    .search-results li { animation: search-hit-enter 220ms cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--hit-index) * 35ms); }
    @keyframes search-hit-enter { from { opacity: 0; transform: translateY(6px); } }
    .hit-kind { font-family: var(--font-data); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-text); }
    .hit-title { font-weight: 600; }
    .hit-desc { font-size: 13px; color: var(--on-surface-v); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .search-empty { color: var(--secondary); font-size: 14px; padding: 16px 4px 4px; margin: 0; }
    .search-announcement {
      position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap;
    }

    /* ---- Footer ---- */
    .site-footer { border-top: 1px solid var(--ghost); margin-top: 96px; }
    .footer-inner {
      max-width: var(--max-w); margin: 0 auto;
      display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px;
      padding: 48px 20px 32px;
    }
    .footer-brand p { color: var(--secondary); font-size: 14px; margin: 12px 0 0; max-width: 320px; }
    .footer-col { display: grid; gap: 10px; align-content: start; }
    .footer-label { font-family: var(--font-data); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-text); }
    .footer-col a { color: var(--on-surface-v); text-decoration: none; font-size: 14px; }
    .footer-col a:hover { color: var(--on-surface); }
    .footer-meta {
      max-width: var(--max-w); margin: 0 auto;
      display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
      padding: 0 20px 32px;
      color: var(--muted-text); font-size: 12px;
    }
    @media (max-width: 900px) {
      .nav { position: relative; gap: 12px; }
      .menu-btn {
        display: inline-flex !important; align-items: center; gap: 8px; margin-left: auto;
        min-height: 40px; padding: 0 12px; border: 1px solid var(--ghost); border-radius: 999px;
        background: transparent; color: var(--on-surface-v); font: 500 13px/1 var(--font-body); cursor: pointer;
      }
      .menu-btn, .search-btn, .language-switcher { flex: 0 0 auto; }
      .menu-icon { position: relative; width: 14px; height: 10px; border-block: 1px solid currentColor; }
      .menu-icon::after { content: ''; position: absolute; left: 0; right: 0; top: 4px; border-top: 1px solid currentColor; }
      .nav-links {
        display: none; position: absolute; top: 100%; left: 12px; right: 12px;
        grid-template-columns: 1fr 1fr; gap: 0; margin: 0; padding: 10px;
        max-height: calc(100dvh - 68px); overflow-y: auto;
        border: 1px solid var(--ghost); border-radius: 0 0 var(--radius-tile) var(--radius-tile);
        background: rgba(8,8,8,.98); box-shadow: 0 20px 40px rgba(0,0,0,.35);
      }
      .nav-links.open { display: grid; }
      .nav-links a { padding: 13px 12px; border-radius: 8px; }
      .nav-links a:hover { background: var(--surface-ch); }
      .footer-inner { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      .menu-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .menu-btn { width: 40px; justify-content: center; padding: 0; }
      .nav-links { grid-template-columns: 1fr; }
      .search-panel { padding: 20px; }
    }
    @media (max-width: 340px) {
      .nav .brand-name { display: none; }
    }
  </style>
</body>
