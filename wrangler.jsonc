{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dbcheck-website",
  "compatibility_date": "2026-07-12",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "dbcheck.app",
      "custom_domain": true
    }
  ]
}
