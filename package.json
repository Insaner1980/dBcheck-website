{
  "name": "dbcheck-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "deploy:dry-run": "npm run build && wrangler deploy --config wrangler.jsonc --dry-run",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "check": "astro check",
    "test": "npm run build && node --experimental-strip-types --test",
    "test:browser": "npm run build && node scripts/text-wrapping.browser.mjs",
    "test:text-wrapping": "npm run test:browser"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/sitemap": "3.7.3",
    "animejs": "^4.5.0",
    "astro": "^7.1.6",
    "katex": "0.17.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "7.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
